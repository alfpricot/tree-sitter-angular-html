{
  "name": "tree-sitter-angular-html",
  "version": "0.1.0",
  "description": "Tree-sitter grammar for Angular HTML templates",
  "main": "bindings/node",
  "types": "bindings/node",
  "scripts": {
    "install": "node-gyp-build",
    "prestart": "tree-sitter build --wasm",
    "start": "tree-sitter playground",
    "test": "node --test bindings/node/*_test.js",
    "lint": "oxlint grammar.js grammar tools bindings/node",
    "format": "oxfmt grammar.js \"grammar/**/*.js\" \"tools/**/*.mjs\" \"bindings/node/*.js\"",
    "format:check": "oxfmt --check grammar.js \"grammar/**/*.js\" \"tools/**/*.mjs\" \"bindings/node/*.js\""
  },
  "author": "M. Reifschneider",
  "license": "MIT",
  "dependencies": {
    "node-addon-api": "8.9.2",
    "node-gyp-build": "4.8.4"
  },
  "devDependencies": {
    "node-gyp": "13.1.0",
    "oxfmt": "0.74.0",
    "oxlint": "1.89.0",
    "tree-sitter": "0.25.1",
    "tree-sitter-cli": "0.27.1"
  },
  "peerDependencies": {
    "tree-sitter": "^0.25.0"
  },
  "peerDependenciesMeta": {
    "tree-sitter": {
      "optional": true
    }
  },
  "gypfile": true,
  "directories": {
    "test": "test"
  },
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alfpricot/tree-sitter-angular-html.git"
  },
  "bugs": {
    "url": "https://github.com/alfpricot/tree-sitter-angular-html/issues"
  },
  "homepage": "https://github.com/alfpricot/tree-sitter-angular-html#readme",
  "keywords": [
    "parser",
    "angular",
    "html",
    "template",
    "tree-sitter"
  ],
  "files": [
    "grammar.js",
    "grammar/**",
    "binding.gyp",
    "bindings/node/*",
    "queries/*",
    "src/**",
    "prebuilds/**",
    "tree-sitter.json",
    "NOTICE"
  ],
  "allowScripts": {
    "tree-sitter-cli@0.27.1": true,
    "tree-sitter@0.25.1": true
  }
}
